# Web Service Environment Configuration
# Copy this file to web.env and update with your actual values

# Production server domain
SERVER=your-domain.com

# Database connection (should match db service)
DB_HOST=db
DB_PORT=5432
DB_NAME=arbolsaf

# CHANGE THESE: Use strong passwords
DB_USER=your-db-user
DB_PASSWORD=your-secure-database-password-min-16-chars
